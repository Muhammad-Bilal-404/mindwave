{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information for all roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "student", "parent", "it-manager"] },
        "isBlocked": { "type": "boolean" },
        "grade": { "type": "string" },
        "rollNumber": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "assignedClasses": { "type": "array", "items": { "type": "string" } },
        "verifiedStudentIds": { "type": "array", "items": { "type": "string" } },
        "pendingStudentIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "TestResult": {
      "title": "Test Result",
      "description": "Student test session results",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "rollNumber": { "type": "string" },
        "class": { "type": "string" },
        "subject": { "type": "string" },
        "obtainedMarks": { "type": "string" },
        "totalMarks": { "type": "string" },
        "testDate": { "type": "string" },
        "week": { "type": "string" },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Enrollment": {
      "title": "Enrollment Application",
      "description": "Student enrollment application data",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "grade": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Lesson": {
      "title": "Daily Lesson",
      "description": "Lesson content for students",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "class": { "type": "string" },
        "videoUrl": { "type": "string" },
        "resources": { "type": "array", "items": { "type": "string" } },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Homework or project assignments",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "class": { "type": "string" },
        "dueDate": { "type": "string" },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Attendance": {
      "title": "Attendance Record",
      "description": "Student daily attendance",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "subject": { "type": "string" },
        "teacherId": { "type": "string" }
      }
    },
    "Remark": {
      "title": "Teacher Remark",
      "description": "Feedback on student performance",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["Good", "Average", "Poor"] },
        "comment": { "type": "string" },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/enrollments/{enrollmentId}": { "schema": "Enrollment", "description": "Enrollment applications" },
    "/testResults/{resultId}": { "schema": "TestResult", "description": "Test results" },
    "/lessons/{lessonId}": { "schema": "Lesson", "description": "Daily lessons" },
    "/assignments/{assignmentId}": { "schema": "Assignment", "description": "Student assignments" },
    "/attendance/{attendanceId}": { "schema": "Attendance", "description": "Attendance records" },
    "/remarks/{remarkId}": { "schema": "Remark", "description": "Teacher remarks" }
  }
}
